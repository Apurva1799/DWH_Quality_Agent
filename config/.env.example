# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Database Configuration
MSSQL_SERVER=your-mssql-server
MSSQL_PORT=1433
MSSQL_DATABASE=your-database
MSSQL_USERNAME=your-username
MSSQL_PASSWORD=your-password

# Existing LLM Client Configuration
SEQUENTIAL_LLM_BASE_URL=http://your-nemotron-server:port
SEQUENTIAL_LLM_VERIFY_SSL=false
SEQUENTIAL_LLM_MODEL=nemotron-4-340b

DGX_3B_BASE_URL=https://your-dgx-server:8193
DGX_3B_VERIFY_SSL=false
DGX_3B_MODEL=qwen-72b
DGX_3B_RATE=50

# DocumentDB Configuration
DOCUMENTDB_BASE_URL=http://your-documentdb-server:port
DOCUMENTDB_USERNAME=your-username
DOCUMENTDB_PASSWORD=your-password
DOCUMENTDB_SSL_VERIFY=true

# Redis Configuration (for caching and message broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Agent Configuration
MAX_SQL_EXECUTION_TIME=30
MAX_TOKENS=4000
TEMPERATURE=0.1

# Conversation Management
MAX_CONVERSATION_HISTORY=20
SESSION_TIMEOUT=3600
